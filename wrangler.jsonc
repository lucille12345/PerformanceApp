// Cloudflare Worker settings. The name must match the Worker in the Cloudflare dashboard.
{
  "name": "performance-app",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Keep the variables typed in the dashboard when a new version deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
